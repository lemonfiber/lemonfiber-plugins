{
  "recorded_from": "docker.io/jellyfin/jellyfin@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db",
  "note": "What a guard in front of Jellyfin enforces and where it serves each item, answered without asking Jellyfin.",
  "request": {
    "method": "POST",
    "path": "/lemonfiber/media.serve/v1/declared",
    "accept": "application/json"
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "bytes": [
        {
          "pattern": "(?i)^(?:/emby|/mediabrowser)?/Videos/(?P<item>[^/]+)/Trickplay(?:/|$)",
          "item": "(?i)^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$",
          "exempt": [],
          "naming": [
            {
              "parameter": "itemId",
              "held": "refused"
            },
            {
              "parameter": "LiveStreamId",
              "held": "refused"
            },
            {
              "parameter": "MediaSourceId",
              "held": {
                "asked": {
                  "shape": "^[0-9a-f]{32}$"
                }
              }
            }
          ]
        },
        {
          "pattern": "(?i)^(?:/emby|/mediabrowser)?/(?:Videos|Audio|LiveTv/LiveStreamFiles|LiveTv/LiveRecordings)/(?P<item>[^/]+)(?:/|$)",
          "item": "(?i)^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$",
          "exempt": [
            "(?i)^(?:/emby|/mediabrowser)?/Videos/(?:ActiveEncodings|MergeVersions)$"
          ],
          "naming": [
            {
              "parameter": "itemId",
              "held": "refused"
            },
            {
              "parameter": "LiveStreamId",
              "held": "refused"
            }
          ]
        },
        {
          "pattern": "(?i)^(?:/emby|/mediabrowser)?/Items/(?P<item>[^/]+)/(?:Images|Download|File)(?:/|$)",
          "item": "(?i)^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$",
          "exempt": [],
          "naming": [
            {
              "parameter": "itemId",
              "held": "refused"
            },
            {
              "parameter": "LiveStreamId",
              "held": "refused"
            }
          ]
        }
      ],
      "refused": [
        "(?i)^(?:/emby|/mediabrowser)?/(?:Artists|Genres|MusicGenres|Persons|Studios)/[^/]+/Images(?:/|$)",
        "(?i)^(?:/emby|/mediabrowser)?/Branding/Splashscreen/?$"
      ],
      "question": {
        "method": "get",
        "path": "/Items/{item}",
        "to": "upstream",
        "answers": {
          "may": [
            {
              "from": 200,
              "to": 299
            }
          ],
          "may_not": [
            {
              "from": 404,
              "to": 404
            }
          ],
          "no_session": [
            {
              "from": 401,
              "to": 401
            }
          ],
          "not_from_there": [
            {
              "from": 403,
              "to": 403
            }
          ]
        }
      },
      "token": {
        "presented": {
          "header": {
            "name": "Authorization",
            "value": "MediaBrowser Token=\"{token}\""
          }
        },
        "shape": "^[0-9a-f]{32}$",
        "parameters": [
          "ApiKey",
          "api_key"
        ]
      },
      "locations": {
        "stream": "{base}/Videos/{item}/master.m3u8?MediaSourceId={item}&VideoCodec=h264,hevc&AudioCodec=aac,mp3,ac3,eac3&SegmentContainer=mp4",
        "poster": "{base}/Items/{item}/Images/Primary",
        "backdrop": "{base}/Items/{item}/Images/Backdrop"
      },
      "ports": {
        "upstream": 8096,
        "encrypted": 8920
      }
    }
  }
}
